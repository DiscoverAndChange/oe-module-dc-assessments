{
  "name": "discoverandchange/oe-module-dc-assessments",
  "description": "Patient Assignment/Assessment system for OpenEMR",
  "type": "openemr-module",
  "license": "GPL-3.0-only",
  "authors": [
    {
      "name": "Stephen Nielson",
      "email": "snielson@discoverandchange.com",
      "role": "Developer"
    }
  ],
  "keywords": ["openemr", "openemr-module"],
  "minimum-stability": "stable",
    "require": {
    	"openemr/oe-module-installer-plugin": "^0.1.0",
        "doctrine/orm": "^2.11.0",
        "doctrine/dbal": "^3.2",
        "symfony/yaml": "~6.4.26",
        "symfony/cache": "^6.4",
        "symfony/routing": "^6.4",
        "symfony/psr-http-message-bridge": "~6.4.24",
        "symfony/property-access": "^6.4",
        "symfony/serializer": "^6.4",
        "phpdocumentor/reflection-docblock": "^5.3"
    },
    "conflict": {
      "openemr/openemr": "<7.0.4"
    },
    "autoload": {
	"psr-4": {
	    "OpenEMR\\Modules\\DiscoverAndChange\\Assessments\\": "src/"
	}
    },
    "scripts": {
        "phpstan": "MODULE_DIR=$(pwd) && cd ${MODULE_DIR}/../../../.. && php -d memory_limit=4G vendor/bin/phpstan analyze --configuration=phpstan.neon.dist ${MODULE_DIR}/src",
        "rector-check": "MODULE_DIR=$(pwd) && cd ${MODULE_DIR}/../../../.. && php -d memory_limit=4G vendor/bin/rector process --dry-run ${MODULE_DIR}/src",
        "rector-fix": "MODULE_DIR=$(pwd) && cd ${MODULE_DIR}/../../../.. && php -d memory_limit=4G vendor/bin/rector process ${MODULE_DIR}/src",
        "test": "MODULE_DIR=$(pwd) && cd ${MODULE_DIR}/../../../.. && vendor/bin/phpunit --configuration=${MODULE_DIR}/phpunit.xml"
    },
  "config": {
    "allow-plugins": {
      "openemr/oe-module-installer-plugin": true
    }
  }
}
